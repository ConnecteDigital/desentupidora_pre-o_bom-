---
// Logo da marca. Arquivo: src/assets/logo.webp (para trocar, substitua o arquivo).
// No rodapé (fundo escuro) a logo fica sobre uma etiqueta branca.
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
import { site } from '../data/site';

interface Props {
  href?: string;
  tone?: 'claro' | 'escuro';
}

const { href = '/', tone = 'claro' } = Astro.props;
---

<a href={href} class={`brand brand-${tone}`} aria-label={`${site.name}, página inicial`}>
  <Image src={logo} alt={site.name} width={132} densities={[1, 2]} loading={tone === 'claro' ? 'eager' : 'lazy'} />
</a>
