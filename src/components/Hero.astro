---
// Topo das páginas. Ordem dos destaques: preço primeiro, depois título, contato e selos.
import { Image } from 'astro:assets';
import fotoTopo from '../assets/hero.webp';
import Icon from './Icon.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CtaButtons from './CtaButtons.astro';
import { mensagens } from '../data/site';
import type { Cidade } from '../data/cidades';

interface Props {
  cidade?: Cidade;
  local?: string;
  assunto?: string;
  sufixo?: string;
  // frase curta do topo; sem ela, usa a mensagem padrão da marca
  lead?: string;
  breadcrumbs?: { name: string; path: string }[];
  // mostra o selo amarelo de preço ao lado (páginas principais)
  selo?: boolean;
  cta?: boolean;
}

const LEAD_PADRAO = 'Atendimento 24 horas. Chegamos em 20 minutos em casas, apartamentos, condomínios e comércios.';
const { cidade, local, assunto, sufixo, lead = LEAD_PADRAO, breadcrumbs, selo = false, cta = true } = Astro.props;
---

<section class={`hero ${selo ? 'hero-foto' : 'page-hero'}`}>
  {selo && <Image class="hero-bg" src={fotoTopo} alt="" widths={[480, 800, 1200, 1600]} sizes="100vw" quality={60} loading="eager" fetchpriority="high" />}
  <div class="container">
    <div class="hero-center">
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
      <p class="hero-price">{mensagens.preco}</p>
      <h1><slot /></h1>
      <p class="hero-lead">{lead}</p>
      {cta && <CtaButtons cidade={cidade} local={local} assunto={assunto} sufixo={sufixo} />}
      <ul class="hero-badges">
        <li><Icon name="check" size={18} /> <span>Sem taxa de visita</span></li>
        <li><Icon name="check" size={18} /> <span>{mensagens.emergencia}</span></li>
        <li><Icon name="check" size={18} /> <span>Residencial e comercial</span></li>
      </ul>
    </div>
  </div>
</section>
