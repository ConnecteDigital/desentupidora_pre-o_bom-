---
// Faixa de diferenciais: as mensagens fixas da marca, iguais em todas as praças.
import Icon from './Icon.astro';
---

<section class="trust" aria-label="Diferenciais">
  <div class="container trust-grid">
    <div class="trust-item"><Icon name="tag" size={32} /><div><strong>Orçamento grátis</strong><span>No local e sem compromisso</span></div></div>
    <div class="trust-item"><Icon name="bolt" size={32} /><div><strong>20 minutos</strong><span>Chegamos em 20 minutos</span></div></div>
    <div class="trust-item"><Icon name="clock" size={32} /><div><strong>24 horas</strong><span>Todos os dias, domingos e feriados</span></div></div>
    <div class="trust-item"><Icon name="check" size={32} /><div><strong>Emergências</strong><span>Serviços emergenciais</span></div></div>
    <div class="trust-item"><Icon name="casa" size={32} /><div><strong>Casa e empresa</strong><span>Residencial e comercial</span></div></div>
  </div>
</section>
