---
import Icon from './Icon.astro';
import type { Servico } from '../data/servicos';

interface Props {
  servico: Servico;
  href: string;
}

const { servico, href } = Astro.props;
---

<a class="service-card" href={href}>
  <span class="service-icon"><Icon name={servico.icon} size={28} /></span>
  <h3>{servico.nome}</h3>
  <p>{servico.resumo}</p>
  <span class="service-more">Ver serviço <Icon name="arrow" size={16} /></span>
</a>
