---
// Tag do Google Ads, uma única vez por página, no <head> do layout base.
// Carrega direto (sem adiar), para ler o gclid assim que a página abre.
// A conversão dispara SOMENTE no clique em link de WhatsApp ou de telefone,
// por um único ouvinte delegado no document. Nunca no carregamento da página.
import { GOOGLE_TAG_ID, ROTULO_CONVERSAO_WHATSAPP, ROTULO_CONVERSAO_LIGACAO } from '../data/rastreamento';

const id = GOOGLE_TAG_ID;
const whatsapp = `${GOOGLE_TAG_ID}/${ROTULO_CONVERSAO_WHATSAPP}`;
const ligacao = `${GOOGLE_TAG_ID}/${ROTULO_CONVERSAO_LIGACAO}`;
---

{
  GOOGLE_TAG_ID && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />
      <script is:inline define:vars={{ id, whatsapp, ligacao }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', id);
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href]');
          if (!a) return;
          var href = a.getAttribute('href') || '';
          var sendTo = null;
          if (/wa\.me|api\.whatsapp\.com/i.test(href)) sendTo = whatsapp;
          else if (/^tel:/i.test(href)) sendTo = ligacao;
          if (!sendTo || typeof gtag !== 'function') return;
          gtag('event', 'conversion', { send_to: sendTo });
        }, true);
      </script>
    </>
  )
}
