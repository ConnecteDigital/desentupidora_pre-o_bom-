---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site, urlAbsoluta } from '../../data/site';
import { servicos, servicoPath } from '../../data/servicos';
import { breadcrumbSchema, empresaId } from '../../data/schema';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const servico = servicos.find((s) => s.slug === post.data.servico);
const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: post.data.titulo, path: Astro.url.pathname },
];
const fmt = new Intl.DateTimeFormat('pt-BR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const artigo = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.titulo,
  description: post.data.resumo,
  datePublished: post.data.data.toISOString(),
  mainEntityOfPage: urlAbsoluta(Astro.url.pathname),
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@id': empresaId() },
};
---

<Base title={`${post.data.tituloSeo} | Preço Bom`} description={post.data.resumo} ogType="article" schema={[artigo, breadcrumbSchema(crumbs)]}>
  <section class="hero page-hero">
    <div class="container article">
      <Breadcrumbs items={crumbs} />
      <h1>{post.data.titulo}</h1>
      <p class="hero-lead">{post.data.resumo}</p>
      <p class="hero-lead"><time datetime={post.data.data.toISOString()}>{fmt.format(post.data.data)}</time></p>
    </div>
  </section>
  <section class="section">
    <div class="container article">
      <div class="prose">
        <Content />
        {
          servico && (
            <div class="nota">
              <p>
                Precisa de ajuda com isso? Veja como funciona o serviço de
                <a href={servicoPath(servico)}>{servico.nome.toLowerCase()}</a> e escolha sua cidade para pedir um
                orçamento grátis.
              </p>
            </div>
          )
        }
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
